Output docs/demo.gif

Set FontSize 18
Set Width 980
Set Height 520
Set MarginFill "#111827"
Set Margin 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0ms

Type "go run ./cmd/demo"
Enter
Sleep 2s
Type "2"
Sleep 1s
Type "l"
Type "l"
Sleep 1s
Type "3"
Sleep 1s
Type "4"
Sleep 1s
Type "5"
Sleep 2s
Type "q"
